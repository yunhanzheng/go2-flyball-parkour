# Isaac Gym is installed alongside this repo, never committed into it.
isaacgym*

# Python / editor
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.vscode/
.idea/

# Training output. The two released checkpoints ship in the layout train.py
# writes (<legged_gym>/logs/<proj_name>/<exptid>/), so they are un-ignored
# level by level -- every other run directory stays ignored.
logs/
!legged_gym/logs/
legged_gym/logs/*
!legged_gym/logs/extreme-parkour/
legged_gym/logs/extreme-parkour/*
!legged_gym/logs/extreme-parkour/teacher/
!legged_gym/logs/extreme-parkour/student/
!legged_gym/logs/extreme-parkour/flat_baseline/
# Warm-start anchors for the dual-encoder turn, file by file: the run directories
# also hold event files, env_cfg dumps and videos that must stay out.
!legged_gym/logs/extreme-parkour/dualenc-flat-512/
legged_gym/logs/extreme-parkour/dualenc-flat-512/*
!legged_gym/logs/extreme-parkour/dualenc-flat-512/model_3600.pt
!legged_gym/logs/extreme-parkour/dualenc-wall-warm3600-480p/
legged_gym/logs/extreme-parkour/dualenc-wall-warm3600-480p/*
!legged_gym/logs/extreme-parkour/dualenc-wall-warm3600-480p/model_5000.pt
wandb/

# Temporary / scratch
.tmp-neural-map/
legged_gym/nohup.out
videos/

# Generated at runtime
legged_gym/legged_gym/scripts/terrain_mesh.npz
# play.py --show_cam: URDF copy with the D435i housing, regenerated each run
*_show_cam.urdf
