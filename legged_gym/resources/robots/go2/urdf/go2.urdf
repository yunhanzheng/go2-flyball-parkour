  <!-- NVIDIA Jetson Orin payload enclosure. Its front edge is 107 mm behind
       the front hip-joint axis (base x = 0.1934 m), so the 204 mm enclosure
       spans x = [-0.1176, 0.0864] m. It is centered laterally and rests on
       the top of the base collision box (z = 0.057 m). Mass is distributed
       uniformly through the 204 x 80 x 20 mm box. -->
  <link name="jetson_orin_module">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.415" />
      <inertia ixx="0.000235166667" ixy="0" ixz="0"
               iyy="0.001453053333" iyz="0" izz="0.001660553333" />
    </inertial>
    <visual>
      <!-- Cancel flip_visual_attachments for this Z-up custom OBJ. -->
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0" />
      <geometry>
        <mesh filename="../dae/jetson_orin_rounded.obj"
              scale="0.953271028 1 1" />
      </geometry>
      <material name="go2_shell_silver">
        <color rgba="0.6717055 0.6924257 0.7742702 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.204 0.080 0.020" />
      </geometry>
    </collision>
  </link>
  <joint name="jetson_orin_module_joint" type="fixed">
    <origin xyz="-0.0156 0 0.067" rpy="0 0 0" />
    <parent link="base" />
    <child link="jetson_orin_module" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- Intel RealSense D435i model.
       The joint pose is the Isaac depth-camera configuration: the depth-ray
       origin is at base-frame xyz [0.33, 0, 0.08], pitched 20 degrees down.
       D435 dimensions and sensor offsets follow realsense2_description.
       The 72 g camera mass is included, so Isaac folds its inertial properties
       into base when fixed joints are collapsed. Collision is omitted because
       the configured ray origin lies inside the housing: including that box in
       Warp self-geometry would make the camera render its own enclosure. -->
  <link name="depth_camera_housing">
    <inertial>
      <origin xyz="0 -0.0175 0" rpy="0 0 0" />
      <mass value="0.072" />
      <!-- Uniform-box inertia derived from 25.05 x 90 x 25 mm. -->
      <inertia ixx="0.00005235" ixy="0" ixz="0"
               iyy="0.000007515015" iyz="0" izz="0.000052365015" />
    </inertial>
    <visual>
      <!-- The Isaac pinhole is the left IR/depth origin. The D435 case is
           centered 17.5 mm to its right in camera-frame Y. -->
      <origin xyz="0 -0.0175 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02505 0.090 0.025" />
      </geometry>
      <material name="d435i_dark_gray">
        <color rgba="0.10 0.11 0.12 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.012575 -0.0175 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0001 0.088 0.023" />
      </geometry>
      <material name="d435i_front_dark_gray">
        <color rgba="0.10 0.11 0.12 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.01275 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.0055" length="0.0004" />
      </geometry>
      <material name="d435i_ir_lens">
        <color rgba="0.08 0.12 0.16 1" />
      </material>
    </visual>
    <visual>
      <origin xyz="0.01275 -0.05 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.0055" length="0.0004" />
      </geometry>
      <material name="d435i_ir_lens" />
    </visual>
    <visual>
      <origin xyz="0.01275 0.015 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius="0.0035" length="0.0004" />
      </geometry>
      <material name="d435i_rgb_lens">
        <color rgba="0.06 0.09 0.13 1" />
      </material>
    </visual>
  </link>
  <joint name="depth_camera_housing_joint" type="fixed">
    <origin xyz="0.33 0 0.08" rpy="0 0.349065850399 0" />
    <parent link="base" />
    <child link="depth_camera_housing" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- ROS optical convention: X right, Y down, Z forward. Isaac itself uses
       depth_camera_housing: X forward, Y left, Z up. -->
  <link name="depth_camera_optical_frame" />
  <joint name="depth_camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
    <parent link="depth_camera_housing" />
    <child link="depth_camera_optical_frame" />
    <axis xyz="0 0 0" />
  </joint>
</robot>
