# checkpoints are 112 MB each, so they go through Git LFS. The older released
# checkpoints (teacher / student / flat_baseline) are small enough to stay as
# regular blobs, so this is scoped to the two files rather than a broad *.pt rule.
legged_gym/logs/extreme-parkour/dualenc-flat-512/model_3600.pt filter=lfs diff=lfs merge=lfs -text
